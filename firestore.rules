rules_version = '2';

// Security baseline (spec section 7): every document under couples/{coupleId}
// is readable/writable only by that couple's two memberIds -- no third
// party, including other Heartlines users, can read a couple's data.
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    // users/{userId} -- a user can read/write only their own profile.
    // Partner display info (name, city, timezone) is read via the couple
    // relationship, never a public listing.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // invites/{code} -- single-use, short-lived pairing codes. Anyone signed
    // in may create one (for themselves) or read one (to redeem it); only
    // the creator may delete it once used. No update -- codes are immutable.
    match /invites/{code} {
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // couples/{coupleId} and everything nested under it -- readable and
    // writable only by the two paired members. Creation is allowed once,
    // by either soon-to-be member, and memberIds may never be changed after.
    match /couples/{coupleId} {
      allow read, update, delete: if isMember(coupleId);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;

      match /{subcollection=**} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
