rules_version = '2';

// Mirrors firestore.rules: voice clips and photos under a couple's folder
// are readable/writable only by that couple's two memberIds (spec section 7).
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isMember(coupleId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if isMember(coupleId);
    }

    // Each user's own avatar source photo, before the pixel-sprite pipeline runs.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
